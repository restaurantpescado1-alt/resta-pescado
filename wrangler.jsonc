{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "resta-pescado",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "resta-pescado"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resta-pescado-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "DEPLOYMENT_MODE": "production",
    "MEDIA_PROVIDER": "imagekit",
    // The ImageKit URL endpoint ("URL endpoint" in the Media Library settings,
    // `https://ik.imagekit.io/your-endpoint`) is public — it prefixes every
    // delivered URL. The placeholder fails closed: only the Worker reads it, and
    // a placeholder endpoint would 404 on every read. The private key is a
    // secret, never a var: `wrangler secret put IMAGEKIT_PRIVATE_KEY`.
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/PLACEHOLDER_ENDPOINT"
  },
  "observability": {
    "enabled": true
  },
  // Preview environment: a separate Worker with its own D1 database, so preview
  // work never reads or writes production data.
  //
  // Configured for this account — never copy these into the top-level block;
  // production stays fail-closed until it is deliberately promoted:
  //   - database_id: resta-pescado-preview-db. Local wrangler storage is keyed
  //     by database_id, so preview and production must stay distinct or preview
  //     would point at the production local database.
  //   - workers.dev subdomain: restaurantpescado1, giving the preview origin
  //     https://resta-pescado-preview.restaurantpescado1.workers.dev.
  //   - BETTER_AUTH_URL / BETTER_AUTH_TRUSTED_ORIGINS: that exact origin.
  //     src/auth.ts reads the former as Better Auth's baseURL; Better Auth
  //     reads the latter from the environment for its CSRF origin check.
  //     IMAGEKIT_PRIVATE_KEY and BETTER_AUTH_SECRET are Worker secrets on top
  //     of these vars: `wrangler secret put <name> --env preview`, never
  //     committed.
  //
  // The R2 bucket bindings that this config held until Phase 5 are gone. Stored
  // media is delivered by the configured provider (IMAGEKIT_URL_ENDPOINT + the
  // IMAGEKIT_PRIVATE_KEY secret) through the /api/media proxy route; no R2
  // bucket needs to be created or bound. The legacy provider (MEDIA_PROVIDER=r2,
  // no bindings needed) exists only to read/delete the objects Phase 1-4
  // uploaded, and to fail closed rather than strand them.
  //
  // An env block is self-contained: it does NOT inherit the top-level vars, so
  // the provider vars have to be repeated here.
  //
  // Cloudflare Access (to restrict who can reach the preview hostname) is
  // configured in the dashboard or via the Cloudflare API, not from
  // wrangler.jsonc; wrangler's `access` key only simulates Access in local dev.
  "env": {
    "preview": {
      "name": "resta-pescado-preview",
      "workers_dev": true,
      "preview_urls": false,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "resta-pescado-preview"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "resta-pescado-preview-db",
          "database_id": "c3de7d61-362e-4e5b-bb22-5c7487e78f35",
          "migrations_dir": "drizzle"
        }
      ],
      "vars": {
        "NEXTJS_ENV": "production",
        "DEPLOYMENT_MODE": "preview",
        // The exact preview origin (workers.dev subdomain `restaurantpescado1`,
        // worker name `resta-pescado-preview`). Public values, so they are vars
        // rather than secrets; a wrong origin here breaks login and lets no
        // cross-origin request pass the CSRF check.
        "BETTER_AUTH_URL": "https://resta-pescado-preview.restaurantpescado1.workers.dev",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://resta-pescado-preview.restaurantpescado1.workers.dev",
        // Preview carries the confirmed public endpoint; the top-level
        // (production) vars still hold PLACEHOLDER_ENDPOINT on purpose, so a
        // production deploy fails closed until that value is promoted.
        "MEDIA_PROVIDER": "imagekit",
        "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/restapescado"
      }
    }
  }
}