# Copy to .dev.vars and fill in real values. .dev.vars is gitignored.
# These values are used by `wrangler dev`, `opennextjs-cloudflare preview`, the
# local seed script, and the Playwright suite.

# --- Better Auth -----------------------------------------------------------
# Required. At least 32 random characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never reuse this value between environments.
BETTER_AUTH_SECRET=

# Public origin of the app. Better Auth uses it to build cookie and callback
# URLs, so it must match where the browser actually is.
BETTER_AUTH_URL=http://localhost:3000

# --- Local development owner account --------------------------------------
# Used only by `npm run db:seed:local` and the Playwright suite. Public sign-up
# is disabled, so this is the only way to create the owner locally.
# OWNER_PASSWORD must be at least 12 characters: Better Auth enforces that.
OWNER_EMAIL=owner@resta-pescado.local
OWNER_PASSWORD=
OWNER_NAME=Propriétaire

# --- Playwright ------------------------------------------------------------
# Port used by `npm run preview` / `opennextjs-cloudflare preview`.
E2E_BASE_URL=http://localhost:8787
