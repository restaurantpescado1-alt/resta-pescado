# Copy to .dev.vars and fill in real values. .dev.vars is gitignored.
# These values are used by `wrangler dev`, `opennextjs-cloudflare preview`, the
# local seed script, and the Playwright suite.

# --- Better Auth -----------------------------------------------------------
# Required. At least 32 random characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never reuse this value between environments.
BETTER_AUTH_SECRET=

# Public origin of the app. Better Auth uses it to build cookie and callback
# URLs, so it must match where the browser actually is.
BETTER_AUTH_URL=http://localhost:3000

# --- Local development owner account --------------------------------------
# Used only by `npm run db:seed:local` and the Playwright suite. Public sign-up
# is disabled, so this is the only way to create the owner locally.
# OWNER_PASSWORD must be at least 12 characters: Better Auth enforces that.
# Remote provisioning (`npm run db:provision:owner`) deliberately never reads
# OWNER_PASSWORD: at --apply time that password is typed twice at a masked
# prompt, and only its hash is written anywhere.
OWNER_EMAIL=owner@resta-pescado.local
OWNER_PASSWORD=
OWNER_NAME=Propriétaire

# --- Playwright ------------------------------------------------------------
# Port used by `npm run preview` / `opennextjs-cloudflare preview`.
E2E_BASE_URL=http://localhost:8787

# --- Media store (ImageKit) ------------------------------------------------
# Phase 5 replaced the R2 bindings with an ImageKit-backed media store. The
# Worker talks to ImageKit's upload API and CDN, and the app only ever emits
# URLs that go through the /api/media proxy.
#
# MEDIA_PROVIDER is "imagekit" (default when these vars are set) or "r2" (the
# legacy shim that can read/delete Phase 1-4 objects but cannot upload).
# MEDIA_PROVIDER=r2
MEDIA_PROVIDER=imagekit
# Public ImageKit URL endpoint (`https://ik.imagekit.io/your-endpoint`). It is
# the base every delivered URL starts from. A placeholder fails closed.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/PLACEHOLDER_ENDPOINT
# Secret: the ImageKit private key. Used to authenticate upload/delete API
# calls. Never set this as a wrangler var; `wrangler secret put
# IMAGEKIT_PRIVATE_KEY` in production, and this file locally.
IMAGEKIT_PRIVATE_KEY=
# Optional overrides of the ImageKit hosts, used only by the automated tests so
# every ImageKit call can hit the local fake server. Production and local dev
# leave these unset and use the real hosts.
# IMAGEKIT_UPLOAD_BASE=http://127.0.0.1:8788
# IMAGEKIT_API_BASE=http://127.0.0.1:8788
